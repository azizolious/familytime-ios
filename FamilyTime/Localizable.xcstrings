            "value": "Sim, eu fiz isso"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet, yaptım"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是的，我已经完成了"
          }
        }
      }
    },
    "step_2_ios_bullet_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open get.familytime.io in Safari/Chrome, on kid's device"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح get.familytime.io في Chrome/Safari على جهاز الطفل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie get.familytime.io in Safari/Chrome auf dem Gerät Ihres Kindes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre get.familytime.io en Safari/Chrome en el dispositivo del niño"
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa get.familytime.io Safari/Chrome, lapsesi laitteella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez get.familytime.io dans Safari/Chrome, sur l'appareil de l'enfant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את get.familytime.io ב-Safari/Chrome, במכשירו של הילד"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
