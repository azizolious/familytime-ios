    "dashboard_family_pause_alert_content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The FamilyPause command has been sent. It might take a few moments for FamilyPause to get activated on your child's device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال أمر استراحة العائلة. قد يستغرق تنشيط استراحة العائلة على جهاز طفلك بضع لحظات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl Familienpause wurde gesendet. Es kann ein paar Momente dauern, bis Familienpause auf dem Gerät Ihres Kindes aktiv wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha colocado el comando Pausa Familiar. Podría tomar un momento para que se active en el dispositivo de tu hijo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Perhe Paussi komento on lähetetty. Saattaa kestää hetken että Perhe Paussi aktivoituu lapsesi laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande Pause familiale a été envoyée. L'activation de Pause familiale sur l'appareil de votre enfant peut prendre quelques instants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פקודת השהיית משפחה נשלחה. ייתכן שיחלפו מספר רגעים עד שמצב השהיית משפחה יופעל במכשיר של ילדך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando Pausa Famiglia inviato. Potrebbe volerci un po' prima che Pausa Famiglia si attivi sul dispositivo di tuo figlio."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ファミリーポーズコマンドが送信されました。お子さまの端末でファミリーポーズが有効になるまでには、しばらく時間がかかる場合があります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando Pausa Familiar foi enviado. Pode levar alguns instantes para que o Pausa Familiar seja ativado no dispositivo do seu filho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FamilyPause komutu gönderildi. FamilyPause'un çocuğunuzun cihazında etkinleştirilmesi birkaç dakika sürebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家人暂停 命令已经发送。家人暂停 可能需要一些时间才能在您孩子的设备上运行。"
          }
        }
      }
    },
