    "DISCLAIMER_TEXT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disclaimer: As required by Apple policy, we do not share any personally identifiable data collected by our service with any third parties for any reason."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخلاء المسؤولية: وفقًا لما تتطلبه سياسة Apple ، لا نشارك أي بيانات تعريف شخصية تم جمعها بواسطة خدمتنا مع أي جهات خارجية لأي سبب من الأسباب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftungsausschluss: Gemäß den Apple-Richtlinien geben wir keine personenbezogenen Daten, die von unserem Dienst erfasst werden, aus irgendeinem Grund an Dritte weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargo de responsabilidad: según lo exige la política de Apple, no compartimos ningún dato de identificación personal recopilado por nuestro servicio con terceros por ningún motivo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastuuvapauslauseke: Applen käytännön mukaisesti emme jaa palvelumme keräämiä henkilökohtaisia ​​tunnistetietoja kolmansille osapuolille mistään syystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clause de non-responsabilité : conformément à la politique d'Apple, nous ne partageons aucune donnée personnellement identifiable collectée par notre service avec des tiers pour quelque raison que ce soit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתב ויתור: כנדרש במדיניות אפל, איננו חולקים נתונים אישיים מזהים שנאספים על ידי השירות שלנו עם צדדים שלישיים מכל סיבה שהיא."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dichiarazione di non responsabilità: come richiesto dalla politica di Apple, non condividiamo alcun dato di identificazione personale raccolto dal nostro servizio con terze parti per nessun motivo。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "免責事項: Apple のポリシーで義務付けられているように、当社は、当社のサービスによって収集された個人を特定できるデータを、理由の如何を問わず第三者と共有することはありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isenção de responsabilidade: conforme exigido pela política da Apple, não compartilhamos nenhum dado de identificação pessoal coletado por nosso serviço com terceiros por qualquer motivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feragatname: Apple politikasının gerektirdiği şekilde, hizmetimiz tarafından toplanan kişisel olarak tanımlanabilir verileri herhangi bir nedenle üçüncü taraflarla paylaşmayız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免责声明：根据 Apple 政策的要求，我们不会出于任何原因与任何第三方共享我们的服务收集的任何个人身份数据。"
          }
        }
      }
    },
