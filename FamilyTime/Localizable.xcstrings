    "fun_time_alert_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have set the End Time for the next day. Please make sure the Start Time and the End Time should be on the same day."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت بإعداد وقت الانتهاء لليوم التالي. يرجى التأكد من أن وقت البدء ووقت الانتهاء يجب أن يكونا في نفس اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben die Endzeit auf den nächsten Tag gelegt. Bitte stellen Sie sicher, dass sich Start- und Endzeit im selben Tag befinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijaste el Fin de Tiempo para el próximo día. Por favor, asegúrate de que el Inicio y Fin del Tiempo sean el mismo día."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet asettanut LOPETUSAJAN seuraavalle päivälle. Varmista että ALOITUSAIKA ja LOPETUSAIKA ovat samana päivänä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez défini l'heure de fin pour le jour suivant. Veuillez vous assurer que l'heure de début et l'heure de fin doivent être le même jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרת את שעת הסיום למחרת. אנא ודא ששעת ההתחלה ושעת הסיום אמורות להיות באותו היום."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai impostato l'Ora di Fine per il giorno dopo. Assicurati che l'Ora di Inizio e l'Ora di Fine siano lo stesso giorno."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻を翌日に設定しました。開始時刻と終了時刻が同じ日になるようにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você estabeleceu a hora de encerramento para o dia seguinte. Se certifique de que a hora de início e a de término sejam no mesmo dia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki gün için Bitiş Zamanını ayarladınız. Lütfen Başlangıç ve Bitiş Zamanının aynı gün olduğundan emin olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已将 结束时间 设定在第二天。请确保 开始时间 和 结束时间 同一天。"
          }
        }
      }
    },
    "fun_time_alert_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FunTime has been updated for your child's device, changes will take effect in a few moments."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث وقت المرح لجهاز طفلك، وستسري التغييرات في غضون لحظات قليلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaßzeit wurde für das Gerät Ihres Kindes aktualisiert, Änderungen werden in wenigen Momenten wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se actualizó la Hora Divertida en el dispositivo de tu hijo, los cambios serán efectivos en breve."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauska Aika on päivitetty lapsesi laitteelle, muutokset astuvat voimaan hetken kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moment de plaisir a été mis à jour pour l'appareil de votre enfant, les changements seront effectifs dans quelques instants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "׳זמן כיף׳ עודכן עבור המכשיר של ילדך, השינויים ייכנסו לתוקף בעוד מספר רגעים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo Divertimento aggiornato per il dispositivo di tuo figlio; le modifiche saranno attive a breve."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さまのデバイス用に楽しい時間がアップデートされ、変更がすぐに反映されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Hora da Diversão foi atualizada para o dispositivo do seu filho, as alterações vão ser habilitadas em instantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "EğlenceZamanı çocuğunuzun cihazı için güncellendi, değişiklikler birkaç dakika içinde uygulanacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经为您孩子的设备更新了 娱乐时间，变更将在片刻后生效。"
          }
        }
      }
    },
