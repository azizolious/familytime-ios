            "state": "translated",
            "value": "Kirjaudu olemassa olevalle FamilyTime-tilillesi tai luo uusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à votre compte existant de FamilyTime ou créez-en un."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "    היכנס לחשבון הקיים שלך ב-FamilyTime או צור חשבון חדש."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi al tuo account esistente di FamilyTime o creane uno nuovo."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "FamilyTimeの既存のアカウントにログインするか、新しいアカウントを作成します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
