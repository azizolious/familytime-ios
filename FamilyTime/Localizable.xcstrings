          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "性的関係、賭博、オンライン カジノのサイトをブロックします。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
