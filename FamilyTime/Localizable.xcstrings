    "alert_sos_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The child has just triggered an SOS alert. Their current location is below."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطلق الطفل للتو تنبيه SOS. موقعه الحالي أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kind hat gerade einen SOS-Alarm ausgelöst. Seine aktuelle Position sehen Sie unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El niño activó una alerta SOS. Su ubicación actual está abajo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapsi on laukaissut SOS-hälytyksen. Heidän nykyinen sijaintisa on alhaalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enfant vient de déclencher une alerte SOS. Sa position actuelle est indiquée ci-dessous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הילד הפעיל זה עתה התראת ׳קריאה לעזרה׳. המיקום הנוכחי שלהם נמצא למטה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bambino ha appena attivato un avviso SOS. Ecco la posizione attuale."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "子供がSOSアラートを鳴らしました。現在地は以下の通りです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A criança acionou um alerta SOS. Sua localização atual está abaixo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuk az önce İMDAT uyarısını tetikledi. Mevcut konumu aşağıdadır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子刚刚触发了一个 SOS 警报。他们目前的位置在下面。"
          }
        }
      }
    },
