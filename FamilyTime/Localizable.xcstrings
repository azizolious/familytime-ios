    "step_1_link_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Having difficulties? Tap here to talk to our support agent!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تواجه صعوبات؟ اضغط هنا للتحدث مع وكيل الدعم الخاص بنا!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwierigkeiten? Hier tippen, um mit unserem Support zu sprechen!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tienes dificultades? ¡Toca aquí para hablar con nuestro agente de soporte!"
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko sinulla ongelmia? Napauta täällä keskustelemaan tukihenkilömme kanssa!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des difficultés? Cliquez ici pour discuter avec un de nos agents de soutien clientèle!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתקל בקשיים? לחץ כאן כדי לדבר עם צוות התמיכה שלנו!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai qualche problema? Contatta il nostro Centro di Assistenza!"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お困りですか？ここをタップして当サポートエージェントにお話しください！"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tendo dificuldades? Toque aqui para falar com nosso agente de suporte!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorluk mu yaşıyorsunuz? Destek temsilcimizle konuşmak için dokunun!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "碰到问题了吗？点击这里与我们的客服沟通！"
          }
        }
      }
    },
