          }
        }
      }
    },
    "step_2_bullet_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After signing in, follow the on-screen instructions and complete the setup on your kid's device"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تسجيل الدخول، اتبع التعليمات التي تظهر على الشاشة وأكمل الإعداد على جهاز طفلك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Anmeldung folgen Sie den Anweisungen auf dem Bildschirm und schließen so die Einrichtung auf dem Gerät Ihres Kindes ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego de ingresar, sigue las instrucciones y completa…"
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet kirjautunut sisään, seuraa ruudulla näkyviä ohjeita suorittaaksesi asennuksen loppuun lapsesi laitteella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après vous être connecté, suivez les instructions à l'écran et terminez la configuration sur l'appareil de votre enfant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר הכניסה, עקוב אחר ההוראות שעל המסך והשלם את ההתקנה במכשיר של ילדך"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo l'accesso, segui le istruzioni sullo schermo e completa il setup sul dispositivo del bimbo"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン後、画面の指示に従って、お子さまの端末の設定を完了します"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de fazer login, siga as instruções na tela e termine a configuração no dispositivo do seu filho"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açtıktan sonra ekrandaki talimatları izleyin ve çocuğunuzun cihazında kurulumu tamamlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，按照屏幕上的指示，在您孩子的设备上完成设置。"
          }
        }
      }
    },
    "step_2_bullet_5": {
