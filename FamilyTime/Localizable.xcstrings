    "speed_limit_alert_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Speed limit has been updated for your child's device, changes will take effect in a few moments."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث حد السرعة لجهاز طفلك، وستسري التغييرات في غضون لحظات قليلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschwindigkeitsbegrenzung wurde für das Gerät Ihres Kindes aktualisiert, Änderungen werden in wenigen Momenten wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se actualizó el Límite de Velocidad en el dispositivo de tu niño, en breve se activará."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopeusrajoitusta on päivitetty lastesi laitteelle, muutokset astuvat voiman hetken kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de vitesse a été mise à jour pour l'appareil de votre enfant. Les changements prendront effet dans quelques instants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגבלת המהירות עודכנה עבור המכשיר של ילדך, השינויים ייכנסו לתוקף בעוד מספר רגעים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di velocità aggiornato per il dispositivo di tuo figlio; le modifiche saranno attive a breve."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さまのデバイスの制限速度が更新されました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de velocidade foi atualizado para o dispositivo do seu filho, as alterações vão ser habilitadas em instantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuğunuzun cihazı için Hız sınırı güncellendi, değişiklikler birkaç dakika içinde uygulanacak."
