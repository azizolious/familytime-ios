    "geo_places_places_alert_content_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places (Geo-Fence) has been updated, changes will take effect in few moments."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث الأماكن (الحدود الجغرافية)، وستسري التغييرات في غضون لحظات قليلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orte (Geo-Fence) wurden aktualisiert, Änderungen werden in wenigen Momenten wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se actualizó lugares (Geovalla). Los cambios serán efectivos en breve."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikkoja (Geo-Aita) on päivitetty, muutokset astuvat voimaan hetken kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieux (Clôture géographique) a été mis à jour, les changements prendront effet dans quelques instants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקומות (גדר-גאוגרפית) עודכנו, השינויים ייכנסו לתוקף בעוד מספר רגעים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luoghi (Geo-Recinzione) aggiornati; le modifiche saranno attive tra pochi istanti."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "場所（ゲオフェンス）が更新されました。変更はすぐに反映されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Places (Geo-Fence) foi atualizado, as alterações entrarão em prática em alguns instantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerler (Coğ-Sınır) güncellendi, değişiklikler birkaç dakika içinde uygulanacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点（地理围栏）已经更新，变更将在几秒钟内生效。"
          }
        }
      }
    },
