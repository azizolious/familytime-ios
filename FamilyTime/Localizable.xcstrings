    "internet_filters_alert_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet Filter settings have been uploaded for your child's device, and changes will take effect in a few moments."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحميل إعدادات تصفية الإنترنت لجهاز طفلك، وستسري التغييرات في غضون لحظات قليلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetfilter-Einstellungen wurden auf das Gerät Ihre Kindes hochgeladen, Änderungen werden in wenigen Momenten wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ajuste para Filtros de Internet ha sido actualizado en el dispositivo de tu hijo y los cambios tomarán efecto en breve."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetsuodattimien asetukset on ladattu lapsesi laitteelle ja muutokset astuvat voimaan hetken kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres du filtre Internet ont été téléchargés pour l'appareil de votre enfant, et les changements prendront effet dans quelques instants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות מסנן אינטרנט הועלו עבור המכשיר של ילדך, והשינויים ייכנסו לתוקף בעוד מספר רגעים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni Filtro Internet caricate per il dispositivo di tuo figlio; le modifiche saranno attive a breve."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットフィルタの設定がアップロードされ、まもなく変更が有効になります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações do Filtro de Internet foram enviadas para o dispositivo do seu filho e as alterações entrarão em prática em alguns instantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuğunuzun cihazına İnternet Filtresi ayarları yüklendi ve değişiklikler birkaç dakika içinde uygulanacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为您孩子的设备上传了 互联网过滤器 设置，变更将在片刻后生效。"
          }
        }
      }
    },
    "internet_filters_alert_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enable at least one option to apply Internet Filters on your child's device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تمكين خيار واحد على الأقل لتطبيق تصفية الإنترنت على جهاز طفلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte aktivieren Sie mindestens eine Option, um Internetfilter auf das Gerät Ihres Kindes anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa al menos una opción para aplicar los Filtros de Internet en el dispositivo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Ole hyvä ja ota käyttöön ainakin yksi vaihtoehto asettaaksesi Internetsuodattimet lapsesi laitteelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez activer au moins une option pour appliquer les filtres Internet sur l'appareil de votre enfant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל לפחות אפשרות אחת להחלת מסנני אינטרנט במכשיר של ילדך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita almeno 1 opzione per applicare filtri Internet a dispositivo di tuo figlio."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さまの端末でインターネットフィルタを適用するために、少なくとも1つのオプションを有効にしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative pelo menos uma opção para aplicar Filtros de Internet no dispositivo do seu filho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen çocuğunuzun cihazında İnternet Filtreleri uygulamak için en az bir seçeneği etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少启用一个选项，这样才能在您孩子的设备上应用互联网过滤器。"
          }
        }
      }
    },
