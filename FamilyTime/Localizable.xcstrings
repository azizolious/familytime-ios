    "upgradeToEnjoyPremium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade now to enjoy all the premium features."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالترقية الآن للاستمتاع بجميع الميزات المتميزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie jetzt, um alle Premium-Funktionen zu genießen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice ahora para disfrutar de todas las funciones premium."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä nyt, niin voit nauttia kaikista premium-ominaisuuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à niveau maintenant pour profiter de toutes les fonctionnalités premium."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שדרג עכשיו כדי ליהנות מכל תכונות הפרימיום."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui l'upgrade ora per usufruire di tutte le funzionalità premium."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐアップグレードして、すべてのプレミアム機能をお楽しみください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize agora para aproveitar todos os recursos premium."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm premium özelliklerin keyfini çıkarmak için şimdi yükseltin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即升级以享受所有高级功能。"
          }
        }
      }
    },
    "upgrade_status": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account status is free and all premium features have been locked down. Please upgrade your account to premium to get access to all of FamilyTime\\'s premium benefits."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة حسابك مجانية وتم إغلاق جميع الميزات الفائقة. يرجى ترقية حسابك إلى الحالة الفائقة للحصول على جميع مزايا تطبيق FamilyTime الفائقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Kontostatus ist kostenlos und alle Premium-Funktionen wurden gesperrt. Aktualisieren Sie Ihr Konto auf Premium, um auf alle Premium-Vorteile von FamilyTime zugreifen zu können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes una cuenta gratuita y todas las funciones Premium han sido bloqueadas. Por favor, mejora tu cuenta a Premium para obtener acceso a todos los beneficios Premium de FamilyTime."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi tila on ilmainen ja kaikki premium-ominaisuudet on lukittu. Päivitä tilisi palkkioon päästäksesi kaikkiin FamilyTime-palkkio-etuuksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statut de votre compte est gratuit et toutes les fonctionnalités premium ont été verrouillées. Veuillez mettre à niveau votre compte Premium pour accéder à tous les avantages Premium de FamilyTime."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סטטוס החשבון שלך הוא חינמי וכל תכונות הפרימיום ננעלו. אנא שדרג את חשבונך לפרימיום כדי לקבל גישה לכל הטבות הפרימיום של FamilyTime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato del tuo account è gratuito e tutte le funzionalità premium sono state bloccate. Aggiorna il tuo account a premium per accedere a tutti i vantaggi premium di Family Time."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのステータスは無料で、すべてのプレミアム機能がロックされています。 ファミリータイムのすべてのプレミアム特典にアクセスするには、アカウントをプレミアムにアップグレードしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O status da sua conta é gratuito e todos os recursos premium foram bloqueados. Atualize sua conta para premium para ter acesso a todos os benefícios premium do FamilyTime."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap durumunuz ücretsizdir ve tüm premium özellikler kilitlenmiştir. FamilyTime\\'ın tüm premium avantajlarına erişmek için lütfen hesabınızı premiuma yükseltin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的帐户是免费账户，所有高级功能都已锁定。请将您的帐户升级为高级账户，获取FamilyTime的所有高级功能权益。"
          }
        }
      }
    },
