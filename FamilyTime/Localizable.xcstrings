    "schedule_screen_time_sync_popup_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes you have made would not take effect until you sync them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تدخل التغييرات التي قمت بإجرائها حيز التنفيذ حتى تقوم بمزامنتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Getätigte Änderungen werden erst aktiv, sobald Sie sie synchronisiert haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios no serán efectivos hasta que sincronices."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset joita olet tehnyt eivät astu voimaan ennen kuin synkronoit ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications que vous avez apportées ne prendront effet que lorsque vous les aurez synchronisées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינויים שביצעת לא ייכנסו לתוקף עד שתסנכרנו אותם."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiche apportate non saranno attive fino a sincronizzazione."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "変更した内容は、同期するまで有効になりません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações feitas não terão efeito até que você as sincronize."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaptığınız değişiklikler, senkronize edene kadar geçerli olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您同步这些变更之前，您所做的变更都不会生效。"
          }
        }
      }
    },
