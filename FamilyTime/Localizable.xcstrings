    "invite_parent_text_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite another parent or guardian to access your FamilyTime account from their own device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بدعوة والد أو وصي آخر للوصول إلى حساب Family Time الخاص بك من أجهزتهم الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen weiteren Elternteil oder Aufsichtsperson einladen, damit diese Person von ihrem Gerät aus auf Ihr FamilyTime-Konto zugreifen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a otro padre o representante para que acceda a tu cuenta FamilyTime desde su dispositivo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsu toinen vanhempi tai huoltaja jotta he pääsevät FamilyTime käyttäjällesi omalla laitteellaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez un autre parent ou tuteur à accéder à votre compte Family Time depuis son propre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמן הורה או אפוטרופוס אחר לגשת לחשבון FamilyTime שלך ​​מהמכשיר שלו."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita altro genitore o tutore ad accedere all'account FamilyTime dal proprio dispositivo."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "他の保護者を招待して、自分のデバイスからファミリータイムアカウントにアクセスしてもらいます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Convide outro pai ou responsável para acessar sua conta do Family Time no próprio dispositivo dele."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FamilyTime hesabınıza kendi cihazlarından erişmesi için başka bir ebeveyni veya veliyi davet edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请另一位家长或监护人从他们自己的设备上访问您的 FamilyTime 账户。"
          }
        }
      }
    },
    "invite_parent_text_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation sent to xyz@gmail.com. Please ask them to verify and create the FamilyTime account so that they can manage kids from their own devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال الدعوة إلى xyz@gmail.com. يرجى مطالبتهم بالتحقق من حساب FamilyTime وإنشائه حتى يتمكنوا من إدارة الأطفال من أجهزتهم الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung an xyz@gmail.com gesendet. Bitten Sie sie darum, sich zu verifizieren und das FamilyTime-Konto zu erstellen, damit sie Kinder von ihren eigenen Geräten aus verwalten können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envió la invitación a xyz@gmail.com. Por favor, pide que verifiquen y creen su cuenta para que puedan gestionar los dispositivos de los niños."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsu lähetetty osoitteeseen xyz@gmail.com. Ole hyvä ja pyydä heitä todentamaan ja luomaa familyTime käyttäjä jotta he voivat hallita lapsia omalta käyttäjältään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation envoyée à xyz@gmail.com. Veuillez leur demander de vérifier et de créer le compte familyTime afin qu'ils puissent gérer les enfants à partir de leurs propres appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמנה נשלחה ל-xyz@gmail.com. אנא בקש מהם לאמת וליצור את חשבון FamilyTime כדי שיוכלו לנהל ילדים מהמכשירים שלהם."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invito inviato a xyz@gmail.com. Chiedi loro di verificare e creare l'account FamilyTime per poter gestire i figli dai propri dispositivi."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "招待は xyz@gmail.com に送信されます。自分のデバイスから子供を管理できるように、familyTimeアカウントの確認と作成を依頼してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no email enviado para xyz@gmail.com. Peça para eles verificarem e criarem a conta familyTime para que possam gerenciar as crianças em seus próprios dispositivos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davetiye xyz@gmail.com'a gönderildi. Çocukların kendi cihazlarından yönetebilmeleri için FamilyTime hesabını doğrulamalarını ve oluşturmalarını isteyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请已发送至 xyz@gmail.com。请他们验证并创建 FamilyTime 账户，这样他们就可以从自己的设备上管理孩子。"
          }
        }
      }
    },
    "invite_parent_text_content_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please ask them to verify and create the FamilyTime account so that they can manage kids from their own devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى مطالبتهم بالتحقق من حساب FamilyTime وإنشائه حتى يتمكنوا من إدارة الأطفال من أجهزتهم الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitten Sie sie darum, sich zu verifizieren und das FamilyTime-Konto zu erstellen, damit sie Kinder von ihren eigenen Geräten aus verwalten können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, pide que se creen una cuenta FamilyTime y la verifiquen para que puedan gestionar el dispositivo de los niños desde los suyos."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Ole hyvä ja pyydä heitä todentamaan ja luomaa familyTime käyttäjä jotta he voivat hallita lapsia omalta käyttäjältään"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez leur demander de vérifier et de créer le compte familyTime afin qu'ils puissent gérer les enfants à partir de leurs propres appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא בקש מהם לאמת וליצור את חשבון FamilyTime כדי שיוכלו לנהל ילדים מהמכשירים שלהם."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi loro di verificare e creare l'account FamilyTime per poter gestire i figli dai propri dispositivi."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のデバイスから子供を管理できるように、familyTimeアカウントの確認と作成を依頼してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça para eles verificarem e criarem a conta familyTime para que possam gerenciar as crianças em seus próprios dispositivos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen çocukları kendi cihazlarından yönetebilmeleri için FamilyTime hesabını doğrulamalarını ve oluşturmalarını isteyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请他们验证并创建 FamilyTime 账户，这样他们就可以从自己的设备上管理孩子。"
          }
        }
      }
    },
