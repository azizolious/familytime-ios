    "LOGIN_TO_YOUR_EXISTING_ACCOUNT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login to your existent account of FamilyTime or create new one."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل الدخول إلى حسابك الحالي في FamilyTime أو قم بإنشاء حساب جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich bei Ihrem bestehenden FamilyTime-Konto an oder erstellen Sie ein neues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión en su cuenta existente de FamilyTime o cree una nueva."
          }
        },
