          "stringUnit": {
            "state": "translated",
            "value": "רשימת מעקב אנשי קשר עודכנה, השינויים ייכנסו לתוקף בעוד מספר רגעים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchlist contatti aggiornata; le modifiche saranno attive a breve."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "コンタクトウォッチリストが更新されました。この変更はすぐに反映されます。"
