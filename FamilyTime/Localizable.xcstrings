          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なメールアドレスを入力しているようです。もう一度お試しください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
