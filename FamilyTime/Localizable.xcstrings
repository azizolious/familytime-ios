    "alert_pick_me_up_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack has just triggered a Pick me up notification. Are you going to pick them up? Their location is below."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطلق جاك للتو إشعار اصطحبني. هل ستصطبحه؟ موقعه أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack hat gerade eine Hol' mich ab Benachrichtigung gesendet. Werden Sie ihn abholen? Den Standort sehen Sie unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack acaba de activar una notificación de Recógeme. ¿Vas a buscarlo? Su dirección está abajo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack on juuri laukaissut Nouda minut ilmoituksen. Oletko menossa noutamaan hänet? Heidän sijaintinsa on alapuolella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack vient de déclencher une notification de ramassage. Allez-vous venir le chercher ? Leur emplacement est ci-dessous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ג'ק הפעיל זה עתה הודעת אסוף אותי. האם בכוונתך לאסוף אותו? המיקום שלהם למטה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack ha appena attivato una notifica Vieni a Prendermi. Stai andando? La sua posizione è la seguente."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャックがお迎えの通知を出しました。迎えに行きますか？位置は以下の通りです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack acabou de acionar uma notificação \"Busque-me\". Você vai buscá-los? A localização deles está abaixo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack az önce bir Beni Al bildirimini tetikledi. Onları alacak mısınız? Konum aşağıda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "杰克刚刚触发了一个 接我 通知。您要去接他们吗？他们的位置在下方。"
          }
        }
      }
    },
