    "step_2_alert_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like you have not activated your child yet. Please make sure you have followed all steps or contact FamilyTime customer support."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنك لم تقم بتنشيط جهاز طفلك حتى الآن. يرجى التأكد من اتباعك لجميع الخطوات أو الاتصال بدعم عملاء FamilyTime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es scheint, Sie haben Ihr Kind noch nicht aktiviert. Bitte stellen Sie sicher, dass Sie allen Schritten gefolgt sind oder kontaktieren Sie FamilyTime Kundensupport."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que aún no has activado el dispositivo de tu hijo. Por favor, asegúrate de haber seguido todos los pasos o contacta al servicio de atención de FamilyTime."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää siltä että et ole aktivoinut lastasi vielä. Ole hyvä ja varmista että olet noudattanut kaikkia ohjeita tai ota yhteyttä FamilyTime asiakaspalveluun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble que vous n'ayez pas encore activé votre enfant. Veuillez vous assurer que vous avez suivi toutes les étapes ou contactez le service clientèle de FamilyTime."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שעדיין לא הפעלת את חשבונו של ילדך. אנא ודא שעברת על כל השלבים או צור קשר עם שירות הלקוחות של FamilyTime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che l'attivazione non sia ancora stata eseguita. Assicurati di aver seguito tutti i passaggi o contatta l'assistenza FamilyTime"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子様のアクティベーションがまだのようです。すべてのステップを確認するか、FamilyTimeカスタマーサポートにお問い合わせください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você ainda não ativou o dispositivo do seu filho. Certifique-se de ter seguido todas as etapas ou entre em contato com o suporte ao cliente FamilyTime."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüşe göre çocuğunuzu henüz etkinleştirmemişsiniz. Lütfen tüm adımları uyguladığınızdan emin olun veya FamilyTime müşteri desteği ile iletişime geçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看起来您还没有激活您的孩子账户。请确认您已经按照所有步骤操作，或联系 FamilyTime 客服获得支持。"
          }
        }
      }
    },
    "step_2_alert_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It appears you do not have any browser installed on your phone to open this link."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنه ليس لديك أي متصفح مثبت على هاتفك لفتح هذا الرابط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es scheint, als wäre auf Ihrem Handy kein Browser installiert, um diesen Link zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al parecer no tienes ningún navegador instalado para abrir este link."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää siltä että sinulla ei ole yhtäkään selainta asennettuna puhelimeesi, jossa avat tämä linkki"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble que vous n'ayez pas de navigateur installé sur votre téléphone pour ouvrir ce lien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שאין לך שום דפדפן מותקן בטלפון על מנת לפתוח את הקישור הזה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che non ci sia un browser installato sul telefono per aprire questo link."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを開くには、お使いの携帯電話にブラウザがインストールされていないようです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você não possui nenhum navegador instalado em seu telefone para abrir esse link."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantıyı açmak için telefonunuzda yüklü herhangi bir tarayıcı yok gibi görünüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的手机上好像并未安装任何浏览器，没办法打开这个链接。"
          }
        }
      }
    },
