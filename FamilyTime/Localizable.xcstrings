    "BY_CONTINUING_YOU_ARE_AGREE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing, You are agree to our"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من خلال المتابعة ، فإنك توافق على"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indem Sie fortfahren, erklären Sie sich mit unseren"
          }
        },
        "es": {
