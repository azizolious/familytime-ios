    "geo_places_places_alert_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The location address is not available, please tap on directions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان الموقع غير متوفر ، يرجى الضغط على الاتجاهات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse des Ortes ist nicht verfügbar, bitte klicken Sie auf Wegbeschreibung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación no está disponible, toca sobre las direcciones."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintiosoite ei ole saatavilla, ole hyvä ja paina suuntaohjeita"
