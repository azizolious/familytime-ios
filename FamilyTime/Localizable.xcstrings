    "emergency_unlock_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In case of an emergency, you may need to use the passcode to access a locked device. Please enter the passcode and tap the Set Passcode button to proceed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح رمز المرور في حالات الطوارئ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Notfall müssen Sie möglicherweise den Passcode verwenden, um auf ein gesperrtes Gerät zuzugreifen. Bitte geben Sie den Passcode ein und tippen Sie auf die Schaltfläche „Passcode festlegen“, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En caso de una emergencia, es posible que necesite utilizar el código de acceso para acceder a un dispositivo bloqueado. Ingrese el código de acceso y toque el botón Establecer código de acceso para continuar."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Hätätilanteessa saatat joutua käyttämään salasanaa päästäksesi lukittuun laitteeseen. Anna salasana ja jatka napauttamalla Aseta salasana -painiketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d'urgence, vous devrez peut-être utiliser le mot de passe pour accéder à un appareil verrouillé. Veuillez saisir le code d'accès et appuyez sur le bouton Définir le code d'accès pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במקרה חירום, ייתכן שיהיה עליך להשתמש בקוד הגישה כדי לגשת למכשיר נעול. אנא הזן את קוד הגישה והקש על כפתור הגדר קוד כדי להמשיך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In caso di emergenza, potrebbe essere necessario utilizzare il codice di accesso per accedere a un dispositivo bloccato. Inserisci il passcode e tocca il pulsante Imposta passcode per procedere."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "緊急の場合、ロックされたデバイスにアクセスするためにパスコードの使用が必要になる場合があります。 パスコードを入力し、「パスコードを設定」ボタンをタップして続行してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em caso de emergência, pode ser necessário usar a senha para acessar um dispositivo bloqueado. Digite a senha e toque no botão Definir senha para continuar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acil bir durumda kilitli bir cihaza erişmek için şifreyi kullanmanız gerekebilir. Lütfen şifreyi girin ve devam etmek için Şifreyi Ayarla düğmesine dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在紧急情况下，您可能需要使用密码才能访问锁定的设备。 请输入密码并点击设置密码按钮继续。"
          }
        }
      }
    },
