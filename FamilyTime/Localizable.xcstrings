          }
        }
      }
    },
    "blocks_sites_sexual_relations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It blocks the sites of sexual relations, betting & online casinos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنه يحجب مواقع العلاقات الجنسية والمراهنة والكازينوهات على الإنترنت."
          }
        },
        "de": {
