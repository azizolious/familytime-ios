            "value": "Oui, je l'ai fait"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כן, עשיתי את זה"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì, l'ho fatto"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "はい、完了しました。"
          }
        },
        "pt": {
