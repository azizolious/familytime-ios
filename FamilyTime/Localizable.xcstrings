          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el acceso a todos los sitios web de contenido para adultos y mayores de 18 años."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Estää pääsyn kaikille yli 18-vuotiaille ja aikuisille suunnatuille sivustoille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque l’accès à tous les sites Web à contenu 18+/adulte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חוסם את הגישה לכל אתרי התוכן 18+/בוגר."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca l'accesso a tutti i siti web con contenuti 18+/per adulti."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての 18 歳以上/成人向けコンテンツ Web サイトへのアクセスをブロックします。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia o acesso a todos os sites de conteúdo para maiores de 18 anos/adultos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "18+/yetişkin içerikli web sitelerinin tümüne erişimi engeller."
          }
