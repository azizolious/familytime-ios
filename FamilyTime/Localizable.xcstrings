    "step_2_bullet_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the app opens, sign in with your account information."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند فتح التطبيق، قم بتسجيل الدخول باستخدام معلومات حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich die App öffnet, melden Sie sich mit Ihren Kontoinformationen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa con los datos de tu cuenta cuando abra la app."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun sovellus avautuu, kirjaudu sisään käyttäjätiedoillasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l'application s'ouvre, connectez-vous avec les informations de votre compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאשר האפליקציה נפתחת, היכנס עם פרטי החשבון שלך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app e accedi con le informazioni del tuo account."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが開いたら、アカウント情報を入力してサインインしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o aplicativo abrir, faça login com as informações da sua conta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açıldığında hesap bilgilerinizle oturum açın."
