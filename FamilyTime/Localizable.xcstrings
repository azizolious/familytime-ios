    "block_inappropriate_websites": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block inappropriate websites to ensure kids safety."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر المواقع غير المناسبة لضمان سلامة الأطفال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockieren Sie unangemessene Websites, um die Sicherheit Ihrer Kinder zu gewährleisten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquee sitios web inapropiados para garantizar la seguridad de los niños."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Estä sopimattomat verkkosivustot lasten turvallisuuden varmistamiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquez les sites Web inappropriés pour assurer la sécurité des enfants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסום אתרים לא הולמים כדי להבטיח את בטיחות הילדים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca i siti Web inappropriati per garantire la sicurezza dei bambini."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子様の安全を確保するために不適切な Web サイトをブロックします。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie sites inadequados para garantir a segurança das crianças."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocukların güvenliğini sağlamak için uygunsuz web sitelerini engelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止不当网站以确保孩子的安全。"
          }
        }
      }
    },
    "blocks_access_mature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks access to all 18+/mature content websites."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع الوصول إلى جميع مواقع الويب ذات المحتوى البالغ 18+/للبالغين."
          }
        },
        "de": {
          "stringUnit": {
