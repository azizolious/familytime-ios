          "stringUnit": {
            "state": "translated",
            "value": "כתובת המיקום אינה זמינה, אנא הקש על הוראות הגעה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzo della posizione non disponibile, toccare indicazioni."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "場所の住所は利用できませんので、案内をタップしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço do local não está disponível, por favor, toque em direções."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum adresi mevcut değil, lütfen yol tarifine dokunun."
          }
