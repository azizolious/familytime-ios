    "login_facebook_validation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for registering with FamilyTime. Please provide your email to login to the app in future."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا على التسجيل في FamilyTime. يرجى تقديم بريدك الإلكتروني لتسجيل الدخول إلى التطبيق في المستقبل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für die Registrierung bei FamilyTime. Bitte geben Sie Ihre E-Mail für zukünftige App-Anmeldungen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por registrarte en FamilyTime. Proporciona tu email para ingresar a la app en el futuro."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos rekisteröitymisestäsi FamilyTimeen. Ole hyvä ja käytä sähköpostiosoitettasi jatkossa kirjautuaksesi sovellukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d'être inscrit à FamilyTime. Veuillez fournir votre adresse e-mail pour vous connecter à l'application à l'avenir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תודה שנרשמת ל-FamilyTime. אנא ספק את האימייל שלך כדי להתחבר לאפליקציה בעתיד."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per esserti registrato con FamilyTime. Fornisci la tua email per accedere all'app in futuro."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "FamilyTimeに登録していただき、ありがとうございます。アプリにログインするためのメールアドレスを登録してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por se inscrever no FamilyTime. Por favor, coloque seu e-mail para fazer login no aplicativo depois."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FamilyTime'a kaydolduğunuz için teşekkürler. Giriş yapmak için lütfen e-posta adresinizi girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢您注册 FamilyTime。请提供您的电子邮箱地址以便后续登录。"
          }
        }
      }
    },
