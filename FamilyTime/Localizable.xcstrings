    "device_passcode_popup_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: To change the passcode, please enter the new passcode and tap on the SET button. Enter at least 4 characters."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصيحة: لتغيير رمز المرور، يرجى إدخال رمز المرور الجديد والضغط فوق الزر ضبط. أدخل 4 أحرف على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Um den PIN zu ändern, geben Sie bitte den neuen PIN ein und klicken Sie auf den EINSTELLEN Button. Geben Sie mindestens 4 Zeichen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Para cambiar el código, por favor ingresa uno nuevo y toca el botón FIJAR. Pon al menos 4 caracteres."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinkki: Vaihtaaksesi pääsykoodi, ole hyvä ja aseta uusi koodi ja napauta ASETA-nappia. Laita ainakin 4 merkkiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : pour modifier le code d'accès, veuillez saisir le nouveau code d'accès et appuyez sur le bouton SET. Saisissez au moins 4 caractères."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיפ: כדי לשנות את קוד הגישה, אנא הזן את קוד הגישה החדש והקש על כפתור SET. הזן לפחות 4 תווים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: per cambiare il passcode, inserisci nuovo passcode e tocca il tasto IMPOSTA. Inserisci almeno 4 caratteri."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：パスコードを変更するには、新しいパスコードを入力して「セット」ボタンをタップしてください。少なくとも4文字以上入力してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Para mudar a senha, digite a nova senha e clique no botão SET. Digite no mínimo 4 caracteres."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Parolayı değiştirmek için lütfen yeni parolayı girin ve AYARLA düğmesine dokunun. En az 4 karakter girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：如需变更密码，请输入新的密码并点击“设置”按钮。至少需要输入 4 个字符。"
          }
        }
      }
    },
    "device_passcode_popup_content_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New and old passcode should not be the same."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا يتطابق رمز المرور القديم مع الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuer und alter PIN sollten nicht gleich sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código viejo no puede coincidir con el nuevo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuden ja vanhan pääsykoodin ei kuuluisi olla samoja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau et l'ancien code d'accès ne doivent pas être les mêmes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד סיסמה חדש וישן לא אמור להיות זהה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo e il vecchio passcode non devono essere uguali."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいパスコードと古いパスコードが同じにならないようにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha nova não deve ser a mesma da antiga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ve eski şifre aynı olmamalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的和旧的密码不可以相同。"
          }
        }
      }
    },
    "device_passcode_popup_content_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter Min 4 and Max 16 digits."
          }
        },
        "ar": {
