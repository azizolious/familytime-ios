    "premium_features_content_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot have access to text messages as this feature is locked. Please subscribe to our premium plans to use this feature."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك الوصول إلى الرسائل النصية لأن هذه الميزة مقفلة. يرجى الاشتراك في خطتنا المميزة لاستخدام هذه الميزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben keinen Zugriff auf SMS, da diese Funktion gesperrt ist. Bitte abonnieren Sie unsere Premiumpläne, um diese Funktion zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes tener acceso a los mensajes de texto porque la función está bloqueada. Por favor suscríbete a nuestro plan Premium para usarla."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla ei voi olla pääsyä tekstiviesteihin sillä tämä ominaisuus on lukittu. Ole hyvä ja tilaa premium suunnitelmiamme avataksesi tämän ominaisuuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas accéder aux messages texte car cette fonction est verrouillée. Veuillez vous abonner à nos plans premium pour utiliser cette fonctionnalité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא תהיה לך גישה להודעות טקסט מכיוון שתכונה זו נעולה. אנא הירשם לתוכניות הפרימיום שלנו כדי להשתמש בתכונה זו."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi accedere a messaggi di testo poiché la funzione è bloccata. Iscriviti ai nostri piani premium per usare la funzione."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能はロックされているため、テキストメッセージにアクセスすることはできません。この機能を利用するには、プレミアムプランにご加入ください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode ter acesso a mensagens de texto, pois está bloqueada. Assine nossos planos premium para utilizar esse recurso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu özellik kilitli olduğu için metin mesajlarına erişemezsiniz. Bu özelliği kullanmak için lütfen premium planımıza abone olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无法访问文本信息，因为这个功能被锁定了。请订阅我们的高级版计划以使用此功能。"
          }
        }
      }
    },
    "premium_features_content_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have exceeded the Premium device limit in your current subscription. Kindly upgrade your current subscription for more devices or contact our Customer Support for help."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تجاوزت حد جهاز الخطة المميزة في اشتراكك الحالي. يرجى ترقية اشتراكك الحالي لمزيد من الأجهزة أو اتصل بدعم العملاء للحصول على المساعدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben die maximale Anzahl an Premiumgeräten in Ihrem aktuellen Abonnement erreicht. Bitte upgraden Sie Ihr derzeitiges Abonnement für mehrere Geräte oder kontaktieren Sie unseren Kundenservice für Unterstützung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has excedido el límite de dispositivos Premium de tu suscripción actual. Por favor, actualiza tu suscripción para aumentar el límite o contacta a nuestro Servicio al Cliente para más ayuda."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet ylittänyt Premium laitteiden rajan tämänhetkisellä tilauksellasi. Ole hyvä ja päivitä nykyisnen tilauksesi useammille laitteille tai ota yhteyttä Asiakaspalveluumme saadaksesi apua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez dépassé la limite d'appareils Premium de votre abonnement actuel. Veuillez mettre à niveau votre abonnement actuel pour plus d'appareils ou contacter notre service client pour obtenir de l'aide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חרגת ממגבלת מכשירי הפרימיום במנוי הנוכחי שלך. אנא שדרג את המנוי הנוכחי שלך למכשירים נוספים או צור קשר עם שירות הלקוחות שלנו לקבלת עזרה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai superato il limite Premium del dispositivo nel tuo abbonamento attuale. Aggiorna l'abbonamento attuale per più dispositivi o contatta il nostro Supporto Clienti."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の契約では、プレミアムデバイスの制限を超えています。現在の契約をアップグレードしてデバイスを増やしていただくか、カスタマーサポートまでお問い合わせください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você excedeu o limite de dispositivos Premium em sua assinatura atual. Por favor, atualize sua assinatura para habilitar mais dispositivos ou entre em contato com nosso Suporte ao Cliente para obter ajuda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut aboneliğinizde Premium cihaz sınırını aştınız. Lütfen daha fazla cihaz için mevcut aboneliğinizi yükseltin veya yardım için Müşteri Desteğimizle iletişime geçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的设备数已超出您目前订阅的高级版计划中的设备限制。请升级您当前的订阅计划以提供更多的设备访问，或联系我们的客服以获得帮助。"
          }
        }
      }
    },
