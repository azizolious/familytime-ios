          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz bir e-posta adresi girdiniz. Lütfen tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您输入的电子邮箱地址无效。请再试一次。"
          }
        }
      }
    },
