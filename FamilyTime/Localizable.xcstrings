    "forgot_pasword_content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your email address and we will send you the link. Just click the link and follow the instructions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان بريدك الإلكتروني وسنرسل لك الرابط. فقط قم بالضغط على الرابط واتبع التعليمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihre E-Mail-Adresse ein und wir senden Ihnen einen Link. Einfach auf den Link klicken und den Anweisungen folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa tu email y te enviaremos un link, haz clic y sigue las instrucciones."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta sähköpostiosoitteesti ja lähetämme sinulle linkin. Klikkaa linkkiä ja seuraa ohjeita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre adresse électronique et nous vous enverrons le lien. Cliquez simplement sur le lien et suivez les instructions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכנס את כתובת המייל שלך ואנו נשלח לך את הקישור. לחץ על הקישור ופעל לפי ההוראות."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tuo indirizzo email e ti invieremo il link. Clicca sul collegamento e segui le istruzioni."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "入力していただいたメールアドレスにリンクを送信します。そのリンクをクリックし、手順に従ってください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu endereço de e-mail e enviaremos o link. Basta clicar nele e seguir as instruções."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta adresinizi girin, size bağlantıyı gönderelim. Sadece bağlantıyı tıklayın ve talimatları izleyin."
