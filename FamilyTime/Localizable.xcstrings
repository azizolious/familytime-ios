    "add_child_device_monitoring_child": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindly add a child device to your account to setup digital safety and monitoring for your child."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى إضافة جهاز طفل إلى حسابك لإعداد الأمان الرقمي والمراقبة لطفلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte fügen Sie Ihrem Konto ein Kindergerät hinzu, um die digitale Sicherheit und Überwachung für Ihr Kind einzurichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue un dispositivo infantil a su cuenta para configurar la seguridad y el monitoreo digital de su hijo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Ystävällisesti lisää lapsen laite tilillesi digitaalisen turvallisuuden ja valvonnan määrittämiseksi lapsellesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez ajouter un appareil enfant à votre compte pour configurer la sécurité numérique et la surveillance de votre enfant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא הוסף מכשיר ילד לחשבון שלך כדי להגדיר בטיחות וניטור דיגיטליים עבור ילדך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un dispositivo per bambini al tuo account per configurare la sicurezza digitale e il monitoraggio per tuo figlio."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子様のデジタル セーフティとモニタリングを設定するには、お子様のデバイスをアカウントに追加してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um dispositivo infantil à sua conta para configurar a segurança digital e o monitoramento do seu filho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuğunuzun dijital güvenliğini ve izlemesini ayarlamak için lütfen hesabınıza bir çocuk cihazı ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请向您的帐户添加儿童设备，以便为您的孩子设置数字安全和监控。"
