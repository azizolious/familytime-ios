    "daily_app_limit_alert_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select some options to set up Daily Limit on your child's device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تحديد بعض الخيارات لإعداد الحد اليومي على جهاز طفلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte wählen Sie einige Optionen aus, um das Tageslimit auf dem Gerät Ihres Kindes einzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige algunas opciones para ajustar el Límite Diario del dispositivo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Ole hyvä ja valitse asetuksia valmistellaksesi Päivittäistä Rajoitusta lapsesi laitteelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez sélectionner certaines options pour configurer la limite quotidienne sur l'appareil de votre enfant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא בחר כמה אפשרויות להגדרת מגבלה יומית במכשיר של ילדך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli opzioni per configurare Limite Giornaliero sul dispositivo di tuo figlio."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかのオプションを選択して、お子さまのデバイスに1日の制限を設定してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione algumas opções para configurar o limite diário no dispositivo do seu filho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuğunuzun cihazında Günlük Limit ayarlamak için lütfen bazı seçenekleri seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一些选项，在您孩子的设备上设置每日限制。"
          }
        }
      }
    },
    "daily_app_limit_alert_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily limit for your child has been set, changes will take effect in few moments."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعيين الحد اليومي لطفلك، وستسري التغييرات في غضون لحظات قليلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tageslimit wurde für Ihr Kind eingerichtet, Änderungen werden in wenigen Momenten wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha colocado el límite diario para tu hijo, los cambios tendrán efecto en unos minutos."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittäinen raja joka on asetettu lapsellesi, muutokset astuvat voimaan hetken kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite quotidienne pour votre enfant a été définie, les changements prendront effet dans quelques instants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקבעה מגבלה יומית עבור ילדך, השינויים ייכנסו לתוקף בעוד מספר רגעים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite giornaliero per tuo figlio impostato, le modifiche saranno attive a breve."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さまの1日の制限が設定されました。変更はすぐに反映されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite diário para seu filho foi definido, as alterações entrarão em prática em alguns instantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuğunuz için günlük limit belirlendi, değişiklikler birkaç dakika içinde uygulanacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的孩子的每日限制已经设置好了，变化会很快生效。"
          }
        }
      }
    },
    "daily_app_limit_content_1": {
