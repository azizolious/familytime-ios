    "step_1_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the kid's device's OS to see setup instructions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نظام تشغيل جهاز الطفل للاطلاع على تعليمات الإعداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OS der Geräte der Kinder wählen, um Anleitung zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el SO del dispositivo del niño para ver las instrucciones."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse lapsen laitteen käyttöjärjestelmä nähdäksesi aloitusohjeet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le SE de l'appareil de l'enfant pour voir les instructions de configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר את מערכת ההפעלה של המכשיר של הילד כדי לראות את הוראות ההתקנה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli SO del dispositivo del bimbo per vedere le istruzioni di setup."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子様のデバイスのOSを選択し、設定説明書をご覧ください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o sistema operacional do dispositivo para criança para ver as instruções de configuração."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum talimatları için çocuğunuzun cihazının işletim sistemini seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择孩子的设备的操作系统，然后查看设置说明。"
          }
        }
      }
    },
    "step_1_getstarted_bullet_1": {
