    "sos_para_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**KID NAME** has just triggered an SOS alert. Their current location is below."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطلق **اسم الطفل** تنبيه SOS للتو. موقعه الحالي أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "heeft zojuist een SOS-waarschuwing geactiveerd. Hun huidige locatie is hieronder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**KID NAME** acaba de activar la alerta SOS. Su ubicación actual está abajo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "on juuri käynnistänyt SOS-hälytyksen. Heidän nykyinen sijainti on alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vient de déclencher une alerte SOS. Leur emplacement actuel est ci-dessous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**KID NAME** הפעיל זה עתה התראת ׳קריאה לעזרה׳. המיקום הנוכחי שלהם נמצא מטה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ha appena attivato un avviso SOS. La loro posizione attuale è sotto."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "SOSアラートを起動しました。 現在の場所は以下の通りです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "acaba de acionar um alerta SOS. Sua localização atual é abaixo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**ÇOCUK ADI** az önce bir İMDAT uyarısını tetikledi. Mevcut konumu aşağıdadır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "** KID NAME **刚刚触发了SOS警报。他们目前的位置如下。"
