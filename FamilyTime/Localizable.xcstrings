    "alert_permission_required_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello Michael! Please enable permissions on Jack's Device to run features properly."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا مايكل! يرجى تمكين الأذونات على جهاز جاك لتشغيل الميزات بشكل صحيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo Michael! Bitte gib Jacks Gerät Berechtigungen, damit Funktionen einwandfrei funktionieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola, Michael! Por favor, habilita los permisos en el dispositivo de Jack para ejecutar bien las funciones."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei Michael! Ole hyvä ja ota käyttöön luvat Jackin laitteella jotta ominaisuudet toimivat kunnolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour Michael ! Veuillez activer les permissions sur l'appareil de Jack pour que les fonctions fonctionnent correctement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלום מיכאל! אנא אפשר הרשאות במכשיר של ג'ק כדי להפעיל תוכנות כראוי."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve Michael! Abilita le autorizzazioni sul dispositivo di Jack per eseguire correttamente le funzioni."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは、マイケル！機能を正しく実行するために、ジャックの端末の権限を有効にしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá Michael! Ative as permissões no dispositivo de Jack, para efetuar os recursos de modo correto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba Michael! Özellikleri düzgün bir şekilde çalıştırmak için lütfen Jack'in Cihazındaki izinleri etkinleştir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您好，迈克尔！请在杰克的设备上启用权限，这样才能正常运行功能。"
          }
        }
      }
    },
