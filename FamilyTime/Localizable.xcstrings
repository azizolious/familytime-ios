    "dashboard_child_daily_limit_response_content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please refresh your dashboard after sometime to get the updated Daily App Limit status."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تحديث لوحة التحكم بعد فترة من الوقت للحصول على حالة حدود التطبيقات اليومية المحدّثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte aktualisieren Sie Ihr Dashboard nach einiger Zeit, um den aktualisierten Daily App Limit-Status zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice su panel después de un tiempo para obtener el estado actualizado del Límite diario de la aplicación."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä hallintapaneeli jonkin ajan kuluttua saadaksesi päivitetyn päivittäisen sovelluksen rajan tilan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez actualiser votre tableau de bord dans quelques instants pour que s'affiche la Limite d'Utilisation Quotidienne actuelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא רענן את לוח המחוונים שלך לאחר זמן מה כדי לקבל את סטטוס מגבלת האפליקציות היומי המעודכן."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna il dashboard dopo un po 'di tempo per ottenere lo stato del limite giornaliero app aggiornato."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "更新されたDaily App Limitのステータスを取得するには、しばらくしてからダッシュボードを更新してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize seu painel depois de algum tempo para obter o status atualizado do limite diário de aplicativos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellenmiş Günlük Uygulama Sınırı durumunu almak için lütfen bir süre sonra kontrol panelinizi yenileyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在一段时间后刷新个人面板，获取更新的每日应用限制状态。"
          }
        }
      }
    },
