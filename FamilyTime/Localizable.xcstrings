    "daily_app_limit_empty_list_content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems like there are no installed Apps uploaded yet, to limit the usage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنه لم يتم تحميل أي تطبيقات مثبتة حتى الآن للحد من الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es scheint, als seien noch keine installierten Apps hochgeladen worden, um die Benutzung zu beschränken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al parecer aún no hay Apps registradas para limitar."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää siltä ettei Asennettuja sovelluksia ole vielä päivitetty ottamaan sovellusten rajoittamista käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble qu'aucune application n'ait encore été téléchargée pour limiter l'utilisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שעדיין לא הועלו אפליקציות מותקנות, כדי להגביל את השימוש."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra non ci siano ancora app installate caricate, per limitare l'uso."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "使用量を制限するためのインストール済みアプリがまだアップロードされていないようです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que ainda não há aplicativos instalados e carregados para limitar o uso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanımı sınırlamak için yüklenmiş bir Uygulama yok gibi görünüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "似乎还没有上传已安装的应用程序，现在还无法限制使用。"
          }
        }
      }
    },
