    "instructions_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the in-app instructions on child's device to complete the setup."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع التعليمات الموجودة في التطبيق على جهاز الطفل لإكمال الإعداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befolgen Sie die In-App-Anweisungen auf dem Gerät des Kindes, um die Einrichtung abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga las instrucciones de la aplicación en el dispositivo del niño para completar la configuración."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita asennus loppuun noudattamalla lapsen laitteen sovelluksen sisäisiä ohjeita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les instructions de l'application sur l'appareil de l'enfant pour terminer la configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקוב אחר ההוראות בתוך האפליקציה במכשיר של הילד כדי להשלים את ההגדרה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui le istruzioni in-app sul dispositivo del bambino per completare la configurazione."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子様のデバイスのアプリ内の指示に従って、セットアップを完了します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga as instruções no aplicativo no dispositivo da criança para concluir a configuração."
          }
        },
