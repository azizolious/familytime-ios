    "text_messages_content_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems like there is no record to display."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنه لا يوجد سجل لعرضه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es scheint, dass keine Aufzeichnungen angezeigt werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al parecer no hay un registro que mostrar."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää siltä että näytettävää tietoa ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble qu'il n'y ait pas d'enregistrement à afficher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שאין רשומה להצגה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra non ci siano registri da mostrare."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する記録がないようです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparentemente não há nenhum registro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntülenecek kayıt yok gibi görünüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "似乎没有任何记录可显示。"
          }
        }
      }
    },
