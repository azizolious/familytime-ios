    "schedule_screen_time_rules_alert_content_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time has been updated for your child's device, changes will take effect in a few moments."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث ميزة وقت الشاشة لجهاز طفلك، وستسري التغييرات في غضون لحظات قليلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmzeit für das Gerät Ihres Kindes wurde aktualisiert, Änderungen werden in wenigen Momenten wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time ha sido actualizado para el dispositivo de tu hijo, los cambios serán efectivos en breve."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruutuaikaa on päivitetty lapsesi laitteella, muutokset astuvat voimaan hetken kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps d'écran a été mis à jour pour l'appareil de votre enfant, les changements prendront effet dans quelques instants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זמן המסך עודכן עבור המכשיר של ילדכם, השינויים ייכנסו לתוקף בעוד מספר רגעים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo schermo aggiornato per il dispositivo di tuo figlio; le modifiche saranno attive a breve."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さまのデバイス用にスクリーンタイムが更新されました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tempo de Uso foi atualizado para o dispositivo do seu filho. As alterações entrarão em prática em alguns instantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuğunuzun cihazı için Ekran Süresi güncellendi, değişiklikler birkaç dakika içinde uygulanacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您孩子的设备的 屏幕时间 已被更新，变化会很快生效。"
          }
        }
      }
    },
    "schedule_screen_time_rules_alert_content_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select at least one day of the week."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء تحديد يوم واحد على الأقل من الأسبوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
