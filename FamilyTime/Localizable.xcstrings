    "in_app_purchase_content_5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please upgrade your account to get access to all the powerful features of FamilyTime Premium."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى ترقية حسابك للوصول إلى جميع الميزات القوية لتطبيق FamilyTime المميز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte upgrade dein Konto, um Zugriff auf all die powervollen Funktionen von FamilyTime Premium zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, mejora tu cuenta para acceder a todas las funciones de FamilyTime Premium."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Ole hyvä ja päivitä käyttäjäsi saadaksesi pääsyn kaikkein voimakkaimpiin ominaisuuksiin FamilyTime Premiumilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez mettre à niveau votre compte pour avoir accès à toutes les puissantes fonctionnalités de FamilyTime Premium."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא שדרג את חשבונך כדי לקבל גישה לכל התכונות החזקות של FamilyTime פרימיום."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna il tuo account per avere accesso a tutte le funzioni di FamilyTime Premium."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "FamilyTime プレミアムのパワフルな機能をすべて利用するには、アカウントをアップグレードしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, atualize sua conta para acessar todos os recursos do FamilyTime Premium."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FamilyTime Premium'un tüm güçlü özelliklerine erişmek için lütfen hesabınızı yükseltin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请升级您的账户，以获得 FamilyTime 高级版的所有强大功能。"
          }
        }
      }
    },
    "in_app_purchase_content_6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription will continue to renew unless you cancel at least one day before the period ends."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيستمر تجديد الاشتراك ما لم تقم بالإلغاء قبل يوم واحد على الأقل من انتهاء الفترة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abonnement wird solange erneuert, bis Sie spätestens einen Tag vor dem Ende des Abrechungszeitraums kündigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción seguirá renovándose a menos que la canceles un día antes de que finalice su periodo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilauksesi jatkaa uusiutumista jollet peru sitä vähintään päivää ennen tilausjakson loppua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement continuera à être renouvelé sauf si vous annulez au moins un jour avant la fin de la période."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנוי ימשיך להתחדש אלא אם תבטל לפחות יום אחד לפני סיום התקופה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento continua a rinnovarsi se non viene annullato almeno un giorno prima di fine periodo."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "期間終了の1日前までにキャンセルしない限り、サブスクリプションは継続して更新されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura vai continuar sendo renovada, para remover essa opção você deve cancelar no mínimo um dia antes do término do período."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre sona ermeden en az bir gün önce iptal etmediğiniz sürece abonelik yenilenmeye devam edecektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您在期限结束前至少一天取消，否则订阅将继续。"
          }
        }
      }
    },
    "in_app_purchase_content_7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For more information, please visit our Terms of service and privacy policy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمزيد من المعلومات، يرجى زيارة شروط الخدمة وسياسة الخصوصية الخاصة بنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für mehr Informationen besuchen Sie bitte unsere Allgemeinen Geschäftsbedingungen und Datenschutzbestimmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para más información, por favor visita nuestros Términos de servicio y Política de privacidad."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Saadaksesi lisää tietoa, katso käyttöehtomme ja yksityisyyskäytäntömme"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour plus d'informations, veuillez consulter nos conditions de service et notre politique de confidentialité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למידע נוסף, בקר בתנאי השירות ובמדיניות הפרטיות שלנו."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per altre informazioni, visita Termini di Servizio e privacy policy."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "詳しくは、利用規約とプライバシーポリシーをご覧ください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mais informações, visite nossos Termos de serviço e política de privacidade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla bilgi için lütfen Hizmet Şartlarımızı ve gizlilik politikamızı ziyaret edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需了解更多信息，请访问我们的服务条款和隐私政策。"
          }
        }
      }
