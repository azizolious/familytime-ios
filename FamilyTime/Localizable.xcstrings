    "alert_location_disable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enable location services from the device's  Settings menu and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تمكين خدمات الموقع من قائمة الإعدادات بالجهاز والمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte aktivieren Sie die Standortdienste in den Einstellungen des Gerätes und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor permite los servicios de ubicación en los Ajustes del dispositivo e intenta de nuevo."
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Ole hyvä ja ota sijaintipalvelut käyttöön laitteen asetuksista ja yritä uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez activer les services de localisation dans le menu Paramètres de l'appareil et réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא הפעל שירותי מיקום מתפריט ההגדרות של המכשיר ונסה שוב."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita servizi di localizzazione dalle Impostazioni del dispositivo e riprova."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の設定メニューから位置情報サービスを有効にして、再度お試しください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative os serviços de localização no menu de Configurações do dispositivo e tente outra vez."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen cihazın Ayarlar menüsünden konum servisini etkinleştirin ve tekrar deneyin."
