            "value": "Al continuar, Usted acepta nuestro"
          }
        },
        "fi-FI": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkamalla hyväksyt meidän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez notre"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על ידי המשך, אתה מסכים שלנו"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando, accetti il nostro"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "続行することにより、あなたは私たちに同意します"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando, você concorda com o nosso"
          }
        },
